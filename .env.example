# LLM settings are implemented; infrastructure settings below are reserved.
APP_ENV=development
LOG_LEVEL=INFO

# Models, profiles and tiers live in app/models.json (override with AI_MODELS_FILE).
# Keys are read from the variable named by each model's api_key_ref.
LLM_TIMEOUT_SECONDS=60
# Model ID for the "openai" profile (models.json uses ${OPENAI_MODEL}).
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Distinct credentials: online market reads vs chat/offline writes.
MYSQL_SOURCE_READONLY_DSN=mysql+aiomysql://user:password@localhost:3306/finsights_news
MYSQL_CHAT_DSN=
# Verified TLS to both MySQL nodes (CAs in certs/). Set false only for a local MySQL.
MYSQL_TLS=true
MYSQL_VISION_WRITE_DSN=
POSTGRES_RAG_DSN=
LANGGRAPH_CHECKPOINT_DSN=

OCI_CONFIG_FILE=
OCI_PROFILE=
OCI_NAMESPACE=
OCI_BUCKET=

# Initial multilingual baseline; benchmark against voyage-finance-2.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024

# Jev (TypeSafe System One): the URL and model version are fixed in the client.
TYPESAFE_API_KEY=

AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=60
VERIFIER_MAX_RETRIES=1

# Per-user token quota of chat sessions, Claude-style windows (0 = off).
QUOTA_FIVE_HOUR_TOKENS=150000
QUOTA_WEEKLY_TOKENS=1500000

TYPESAFE_API_KEY=
