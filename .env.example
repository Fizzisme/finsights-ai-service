# LLM settings are implemented; infrastructure settings below are reserved.
APP_ENV=development
LOG_LEVEL=INFO

# Models, profiles and tiers live in app/models.json (override with AI_MODELS_FILE).
# Keys are read from the variable named by each model's api_key_ref.
LLM_TIMEOUT_SECONDS=60
# Model ID for the "openai" profile (models.json uses ${OPENAI_MODEL}).
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Distinct credentials: online market reads vs chat/offline writes.
MYSQL_SOURCE_READONLY_DSN=
MYSQL_CHAT_DSN=
MYSQL_VISION_WRITE_DSN=
POSTGRES_RAG_DSN=
LANGGRAPH_CHECKPOINT_DSN=

OCI_CONFIG_FILE=
OCI_PROFILE=
OCI_NAMESPACE=
OCI_BUCKET=

# Initial multilingual baseline; benchmark against voyage-finance-2.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024

JEV_BASE_URL=
JEV_API_KEY=
JEV_ENABLED=false

AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
VERIFIER_MAX_RETRIES=1
